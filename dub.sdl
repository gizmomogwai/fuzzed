name "fuzzed"
description "A fuzzy finder in dlang."
authors "Christian Koestlin"
copyright "Copyright (c) 2019, Christian Koestlin"
license "MIT"
sourcePaths "source"
importPaths "source"

configuration "library" {
  excludedSourceFiles "source/app.d" "source/testsuite.d" "source/fuzzed/package.d"
  targetType "library"
  targetPath "out/lib"
}

configuration "fuzzed" {
  dependency "tui" version="*"
  dependency "colored" version="*"
  targetType "executable"
  targetName "fuzzed"
  targetPath "out/main"
  excludedSourceFiles "source/testsuite.d"
}

configuration "unittest" {
  dependency "tui" version="*"
  dependency "colored" version="*"
  targetType "executable"
  targetName "unittest"
  targetPath "out/test"

  excludedSourceFiles "source/app.d"
  dependency "unit-threaded" version="~>2.2.6"
  mainSourceFile "source/testsuite.d"
}
